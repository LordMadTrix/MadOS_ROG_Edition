# MadOS ROG Edition — .gitignore
# Règle : Garder SEULEMENT les scripts .sh, le site web, les assets/images et la doc.

# ==========================================
# FICHIERS AUTORISÉS (whitelist conceptuelle)
# ==========================================
# ✅ modules/*.sh
# ✅ install.sh, install_local.sh
# ✅ assets/ (images, logos, wallpapers)
# ✅ *.md (documentation)
# ✅ .gitignore, .gitattributes
# ✅ usb/ (create_mados_usb.bat, .ps1, start.sh)

# ==========================================
# EXCLUSIONS - Systèmes / OS
# ==========================================
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*~
*.code-workspace
__pycache__/

# Logs & temporaires
*.log
*.tmp
/tmp/
/temp/
test_*.sh
*mados_error.log
/build/
/rog_v2_build/

# Archives
*.zip
*.tar.gz
*.tar.bz2
*.7z
*.rar

# Clés / secrets
*.gpg
*.key
*.pem
.env
secret/

# ==========================================
# EXCLUSIONS - Machines Virtuelles & ISO
# ==========================================
MadOS_3.0_AutoVM/
vm/MadOS_3.0_AutoVM/
vm/VMwarePortable/
vm/QemuPortable/
vm/MadOS_3.0_QemuVM/
vm/Qemu_USB_Share/
*.vmdk
*.qcow2
*.vmx
*.vmxf
*.vmsd
*.vmem
*.nvram
*.iso

# ==========================================
# EXCLUSIONS - Scripts helpers & divers
# ==========================================
*.py
*.ps1
*.bat
connect_mados_ssh.bat
# Exceptions : dossier usb/ entierement suivi
!usb/
!usb/**
