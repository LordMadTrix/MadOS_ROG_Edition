# MadOS ROG Edition - Gitignore

# Systèmes de fichiers / OS
.DS_Store
Thumbs.db
Desktop.ini

# Dossiers d'éditeurs & IDE
.vscode/
.idea/
*.swp
*~
# Logs et fichiers temporaires
*.log
/tmp/
/temp/
test_*.sh
*mados_error.log

# Outils de build perso (s'il y en a)
/build/
/rog_v2_build/

# Ignorer d'éventuels clés gpg ou fichiers secrets par accident
*.gpg
*.key
*.pem
.env
secret/

# === Fichiers VM & ISO (Ne jamais pousser sur GitHub) ===
MadOS_3.0_AutoVM/
*.vmdk
*.vmx
*.vmxf
*.vmsd
*.nvram
*.iso
MadOS_VMware.ps1
user-data

# Fichiers de scripts temporaires / helpers Python
harmonize.py
tmp_fix_crlf.py
*.py
